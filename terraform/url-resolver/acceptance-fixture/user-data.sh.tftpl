#!/bin/bash
set -euo pipefail
# The instance is configured to terminate when the guest shuts down. This is a
# cost backstop; Terraform still owns removal of the security group and state.
shutdown -h +60
if ! command -v python3 >/dev/null 2>&1; then
  dnf install -y python3
fi
install -d -m 755 /opt/amt-resolver-fixture
# Terraform substitutes the base64 source before this shell script runs.
# shellcheck disable=SC2016
printf '%s' '${fixture_script_b64}' | base64 --decode > /opt/amt-resolver-fixture/server.py
chmod 644 /opt/amt-resolver-fixture/server.py
fixture_private_ipv4="$(ip -4 -o addr show scope global | awk 'NR == 1 {split($4, parts, "/"); print parts[1]}')"
printf 'AMT_FIXTURE_PRIVATE_IP=%s\n' "$fixture_private_ipv4" > /etc/amt-resolver-fixture.env
cat > /etc/systemd/system/amt-resolver-fixture.service <<'UNIT'
[Unit]
Description=Temporary AMT synthetic redirect fixture
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/amt-resolver-fixture/server.py
EnvironmentFile=/etc/amt-resolver-fixture.env
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now amt-resolver-fixture.service
echo AMT_RESOLVER_FIXTURE_READY > /dev/console
